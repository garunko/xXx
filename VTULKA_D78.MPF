; ===== VTULKA POD KULACHKY, CHAVUN, ZAHOTOVKA D76-80 =====
; ZAHOTOVKA V KULACHKAKH, VYLIT BILSHE 150 MM
; ZMINA INSTRUMENTU: G75 X0 Z0 (U MASHYNNYKH KOORDYNATAKH, DLJA VSIKH INSTRUMENTIV)
; BEZ T7. VNUTRISHNIJ OTVIR - TILKY T6 (SVERDLO D25 + ROZTOCHKA ZSUVOM PO X)
; VUSHKO ZPEREDU (T2 PROTOCHUJE KORPUS)
; T1 PROHIDNYJ  T2 VIDRIZNYJ 3MM  T6 SVERDLO D25
; Z RIZTSJA T2 = KUT PLASTYNY BLYZHCHE DO KULACHKIV (JAK U STAROJI PROGRAMI)
R1=165.1     ; !!! Z PEREDNOHO TORCJA PICLJA TORTSJUVANNJA = Z TORCJA ZAHOTOVKY - PRYPUSK (ZARAZ: 168.125-3.0)
             ; (TORKNUTYS T1 TORCJA ZAHOTOVKY, PODYVYTYS Z NA EKRANI, VPYSATY SJUDY)
             ; UMOVA: R1+20 MENSHE ZA ~300 (HOD Z SVERDLA OBMEZHENYJ)
R2=30.0      ; DOVZHYNA HOTOVOJI VTULKY
R3=2.2       ; TOVSHCHYNA VUSHKA
R4=65.0      ; D VUSHKA
R5=58.0      ; D KORPUSU
R6=49.1      ; D OTVORU POD DETAL
R7=11.9      ; HLYBYNA OTVORU POD DETAL
R8=45.0      ; D SKRIZNOHO OTVORU (UPIR 2.05 MM NA STORONU)
R9=25.0      ; D SVERDLA DLJA ROZRAHUNKU (PERSHYJ VARIANT: DAVAV OTVIR 48.475 PRY X24.1)
R40=0        ; PRUZHYNNI PROHODY: 0=VYMK (JAK BULO), 1=VKL
R11=0.0      ; KOREKTSIJA DNA UPORU (+ = MENSH HLYBOKO, - = BILSH HLYBOKO)
R12=3.0      ; SHYRYNA VIDRIZNOJI PLASTYNY
; --- POHIDNI ZNACHENNJA ---
R20=R1-R2            ; Z ZADNOHO TORCJA HOTOVOJI VTULKY
R23=R20-R12          ; Z VIDRIZKY (KUT PLASTYNY BLYZHCHE DO KULACHKIV)
R21=R1-R3-R12        ; Z CHYSTOVOJI KANAVKY (BIJA STINKY VUSHKA)
R22=R23-1.0          ; KINETS PROTOCHKY T1
R25=R23-1.1          ; Z VERSHYNY SVERDLA U KINTSI
R26=R1-R7+R11        ; Z VERSHYNY SVERDLA NA DNI UPORU
R41=R1+3.0
R42=R25+0.1
R43=R1-25.0
R45=R8-R9            ; X ROZTOCHKY SKRIZNOHO OTVORU
R46=R6-R9            ; X ROZTOCHKY POD DETAL
R36=R45/12           ; KROK PO X (SKRIZNYJ OTVIR, 12 PROHODIV)
R38=(R46-R45)/4      ; KROK PO X (OTVIR POD DETAL, 4 PROHODY)
